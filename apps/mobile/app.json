{
  "expo": {
    "name": "Roteiro Nutri",
    "slug": "roteiro-nutri",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.edu.ifpr.roteironutri"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF7EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "br.edu.ifpr.roteironutri"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "scheme": "roteironutri",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7EC"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Roteiro Nutri usa suas fotos para você escolher a foto de perfil.",
          "cameraPermission": false
        }
      ]
    ]
  }
}
