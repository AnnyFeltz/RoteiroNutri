# Banco de dados
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=senha
DB_NAME=roteironutri

# Servidor
PORT=3001

# Autenticação
JWT_SECRET=troque-este-valor-por-um-segredo-forte
JWT_EXPIRES_IN=7d

# Origens permitidas no CORS (web do nutricionista e Expo web), separadas por vírgula
CORS_ORIGIN=http://localhost:5173,http://localhost:8081

# URL do front web (usada no link de redefinição de senha enviado por e-mail)
WEB_URL=http://localhost:5173

# Fuso horário usado para "hoje" (adesão diária, consultas do dia)
APP_TZ=America/Sao_Paulo

# E-mail (opcional). Sem SMTP_HOST os e-mails são apenas exibidos no console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Roteiro Nutri <nao-responda@roteironutri.com>"
