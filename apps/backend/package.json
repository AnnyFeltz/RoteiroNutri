{
  "name": "backend",
  "version": "1.0.0",
  "description": "API do RoteiroNutri",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:create": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:taco": "sequelize-cli db:seed --seed 20260920200000-alimentos-taco.js",
    "db:seed:demo": "sequelize-cli db:seed --seed 20260920200100-dados-demonstracao.js",
    "db:seed:undo:demo": "sequelize-cli db:seed:undo --seed 20260920200100-dados-demonstracao.js",
    "db:setup": "npm run db:migrate && npm run db:seed:taco",
    "test": "node --test test/"
  },
  "dependencies": {
    "@RoteiroNutri/shared": "workspace:*",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  }
}
